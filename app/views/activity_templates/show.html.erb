<div class="container mx-auto px-4 py-8 max-w-3xl">
  <%= link_to "← Back to Activities", activity_templates_path, 
      class: "text-blue-600 hover:text-blue-800 mb-6 inline-block" %>

  <div class="bg-white rounded-lg shadow-md p-8">
    <div class="flex items-start justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @activity_template.title %></h1>
        <div class="flex items-center gap-3">
          <span class="px-3 py-1 text-sm font-medium bg-blue-100 text-blue-800 rounded">
            <%= @activity_template.primary_target.label %>
          </span>
          <span class="px-3 py-1 text-sm font-medium bg-gray-100 text-gray-800 rounded">
            <%= @activity_template.duration_minutes %> minutes
          </span>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <!-- Materials -->
      <div>
        <h2 class="text-xl font-semibold text-gray-900 mb-3">Materials Needed</h2>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-gray-700 whitespace-pre-line"><%= @activity_template.materials %></p>
        </div>
      </div>

      <!-- Parent Script -->
      <div>
        <h2 class="text-xl font-semibold text-gray-900 mb-3">Parent Script</h2>
        <div class="bg-blue-50 rounded-lg p-4 border-l-4 border-blue-500">
          <p class="text-gray-700 whitespace-pre-line"><%= @activity_template.parent_script %></p>
        </div>
      </div>

      <!-- Variation -->
      <div>
        <h2 class="text-xl font-semibold text-gray-900 mb-3">Simple Variation</h2>
        <div class="bg-green-50 rounded-lg p-4 border-l-4 border-green-500">
          <p class="text-gray-700 whitespace-pre-line"><%= @activity_template.variation %></p>
        </div>
      </div>
    </div>

    <!-- Log Activity Form (Phase 2c) -->
    <% if user_signed_in? && current_user.child_profiles.any? %>
      <div class="mt-8 border-t pt-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Log This Activity</h2>
        <p class="text-gray-600 mb-4 text-sm">Did you try this activity? Let us know how it went!</p>

        <% current_user.child_profiles.each do |child_profile| %>
          <div class="bg-gray-50 rounded-lg p-4 mb-4">
            <h3 class="font-medium text-gray-900 mb-3">For <%= child_profile.name %></h3>
            <%= form_with url: child_profile_activity_logs_path(child_profile), method: :post, local: true, class: "space-y-4" do |form| %>
              <%= hidden_field_tag :activity_template_id, @activity_template.id %>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Completion -->
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Did you complete it?</label>
                  <div class="flex gap-4">
                    <label class="flex items-center cursor-pointer">
                      <%= radio_button_tag "activity_log[completed]", "1", false, class: "mr-2" %>
                      <span class="text-lg">✅ Yes</span>
                    </label>
                    <label class="flex items-center cursor-pointer">
                      <%= radio_button_tag "activity_log[completed]", "0", true, class: "mr-2" %>
                      <span class="text-lg">❌ No</span>
                    </label>
                  </div>
                </div>

                <!-- Enjoyment -->
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">How did it go?</label>
                  <div class="flex gap-4">
                    <label class="flex items-center cursor-pointer">
                      <%= radio_button_tag "activity_log[enjoyment]", "thumbs_up", false, class: "mr-2" %>
                      <span class="text-2xl">👍</span>
                    </label>
                    <label class="flex items-center cursor-pointer">
                      <%= radio_button_tag "activity_log[enjoyment]", "neutral", false, class: "mr-2" %>
                      <span class="text-2xl">😐</span>
                    </label>
                    <label class="flex items-center cursor-pointer">
                      <%= radio_button_tag "activity_log[enjoyment]", "thumbs_down", false, class: "mr-2" %>
                      <span class="text-2xl">👎</span>
                    </label>
                  </div>
                </div>
              </div>

              <!-- Date/Time -->
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">When did you do this?</label>
                <%= datetime_local_field_tag "activity_log[occurred_at]", Time.current.strftime("%Y-%m-%dT%H:%M"), 
                    class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
              </div>

              <!-- Note -->
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Quick note (optional)</label>
                <%= text_area_tag "activity_log[note]", "", 
                    placeholder: "Any notes about how it went...",
                    rows: 3,
                    class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
              </div>

              <%= form.submit "Log Activity", 
                  class: "w-full md:w-auto px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
