<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900"><%= @child_profile.name %>'s Profile</h1>
    <p class="text-gray-600 mt-2">Born: <%= @child_profile.birth_date.strftime("%B %d, %Y") %></p>
  </div>

  <% if @onboarding_session.nil? %>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-6">
      <h2 class="text-xl font-semibold text-blue-900 mb-2">Get Started</h2>
      <p class="text-blue-800 mb-4">Complete the onboarding questionnaire to generate your child's personalized profile.</p>
      <%= link_to "Start Onboarding", start_onboarding_child_profile_path(@child_profile), class: "inline-block px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
    </div>
  <% else %>
    <% if @profile_summary %>
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Profile Summary</h2>
        <div class="prose max-w-none">
          <%= simple_format(@profile_summary.content_markdown) %>
        </div>
      </div>
    <% end %>

    <% if @suggested_goals.any? %>
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Suggested Goals</h2>
        <div class="space-y-4">
          <% @suggested_goals.each do |goal| %>
            <div class="border border-gray-200 rounded-lg p-4">
              <h3 class="font-semibold text-lg text-gray-900 mb-2"><%= goal.short_title %></h3>
              <% if goal.description.present? %>
                <p class="text-gray-600"><%= goal.description %></p>
              <% end %>
              <div class="mt-2">
                <span class="inline-block px-2 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-800">
                  <%= goal.profile_domain.label %>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="bg-gray-50 rounded-lg p-4">
      <%= link_to "View Full Onboarding", onboarding_child_profile_path(@child_profile), class: "text-blue-600 hover:text-blue-800" %>
    </div>
  <% end %>
</div>
