<div class="max-w-5xl mx-auto px-4 py-8 print:max-w-full">
  <!-- Header -->
  <div class="mb-8 print:mb-4">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-4xl font-bold text-gray-900 print:text-2xl"><%= @child_profile.name %>'s Profile</h1>
        <p class="text-gray-600 mt-2 print:text-sm">Born: <%= @child_profile.birth_date.strftime("%B %d, %Y") %></p>
        <% if @child_profile.diagnosis_summary.present? %>
          <p class="text-gray-500 text-sm mt-1 print:text-xs"><%= @child_profile.diagnosis_summary %></p>
        <% end %>
      </div>
      <div class="print:hidden">
        <%= link_to "Print Profile", "#", onclick: "window.print(); return false;", class: "px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50" %>
      </div>
    </div>
  </div>

  <% if @onboarding_session.nil? %>
    <!-- No Profile Yet -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-6">
      <h2 class="text-xl font-semibold text-blue-900 mb-2">Get Started</h2>
      <p class="text-blue-800 mb-4">Complete the onboarding questionnaire to generate your child's personalized profile.</p>
      <%= link_to "Start Onboarding", start_onboarding_child_profile_path(@child_profile), class: "inline-block px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
    </div>
  <% else %>
    <!-- Domain Scores Overview -->
    <% if @domain_profiles.any? %>
      <div class="bg-white rounded-lg shadow-md p-6 mb-6 print:shadow-none print:border print:border-gray-300">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 print:text-xl">Domain Overview</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% @domain_profiles.each do |domain_profile| %>
            <div class="border border-gray-200 rounded-lg p-4 print:border-gray-400">
              <div class="flex justify-between items-start mb-3">
                <h3 class="font-semibold text-lg text-gray-900 print:text-base"><%= domain_profile.profile_domain.label %></h3>
                <%= domain_level_badge(domain_profile.level_estimate) %>
              </div>
              
              <!-- Progress Bar -->
              <div class="w-full bg-gray-200 rounded-full h-2 mb-3 print:bg-gray-300">
                <div class="bg-blue-600 h-2 rounded-full transition-all duration-300" 
                     style="width: <%= domain_level_percentage(domain_profile.level_estimate) %>%"></div>
              </div>
              
              <% if domain_profile.strengths_summary.present? %>
                <div class="mb-2">
                  <p class="text-sm font-medium text-green-700 mb-1">Strengths:</p>
                  <p class="text-sm text-gray-700 print:text-xs"><%= domain_profile.strengths_summary %></p>
                </div>
              <% end %>
              
              <% if domain_profile.needs_summary.present? %>
                <div>
                  <p class="text-sm font-medium text-orange-700 mb-1">Needs:</p>
                  <p class="text-sm text-gray-700 print:text-xs"><%= domain_profile.needs_summary %></p>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Profile Summary -->
    <% if @profile_summary %>
      <div class="bg-white rounded-lg shadow-md p-6 mb-6 print:shadow-none print:border print:border-gray-300">
        <h2 class="text-2xl font-bold text-gray-900 mb-4 print:text-xl">Profile Summary</h2>
        <div class="prose max-w-none print:text-sm">
          <%= simple_format(@profile_summary.content_markdown) %>
        </div>
      </div>
    <% end %>

    <!-- Suggested Goals -->
    <% if @suggested_goals.any? %>
      <div class="bg-white rounded-lg shadow-md p-6 mb-6 print:shadow-none print:border print:border-gray-300">
        <h2 class="text-2xl font-bold text-gray-900 mb-4 print:text-xl">Suggested Goals</h2>
        <div class="space-y-4">
          <% @suggested_goals.each_with_index do |goal, index| %>
            <div class="border border-gray-200 rounded-lg p-5 hover:shadow-md transition-shadow print:border-gray-400">
              <div class="flex justify-between items-start mb-3">
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="text-lg font-bold text-gray-400">#<%= index + 1 %></span>
                    <h3 class="font-semibold text-lg text-gray-900 print:text-base"><%= goal.short_title %></h3>
                    <%= goal_status_badge(goal.status) %>
                  </div>
                  <% if goal.description.present? %>
                    <p class="text-gray-600 print:text-sm"><%= goal.description %></p>
                  <% end %>
                </div>
              </div>
              <div class="flex items-center gap-2 mt-3">
                <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 print:bg-gray-100 print:text-gray-800">
                  <%= goal.profile_domain.label %>
                </span>
                <% if goal.priority_rank.present? %>
                  <span class="text-xs text-gray-500">Priority: <%= goal.priority_rank %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Actions -->
    <div class="bg-gray-50 rounded-lg p-4 print:hidden">
      <div class="flex gap-4">
        <%= link_to "View Full Onboarding", onboarding_child_profile_path(@child_profile), class: "text-blue-600 hover:text-blue-800" %>
        <% if @onboarding_session.present? %>
          <span class="text-gray-400">|</span>
          <span class="text-gray-600 text-sm">Completed: <%= @onboarding_session.created_at.strftime("%B %d, %Y") %></span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<!-- Print Styles -->
<style media="print">
  @media print {
    .print\:hidden { display: none !important; }
    .print\:max-w-full { max-width: 100% !important; }
    .print\:text-2xl { font-size: 1.5rem !important; }
    .print\:text-xl { font-size: 1.25rem !important; }
    .print\:text-base { font-size: 1rem !important; }
    .print\:text-sm { font-size: 0.875rem !important; }
    .print\:text-xs { font-size: 0.75rem !important; }
    .print\:mb-4 { margin-bottom: 1rem !important; }
    .print\:shadow-none { box-shadow: none !important; }
    .print\:border { border-width: 1px !important; }
    .print\:border-gray-300 { border-color: #d1d5db !important; }
    .print\:border-gray-400 { border-color: #9ca3af !important; }
    .print\:bg-gray-100 { background-color: #f3f4f6 !important; }
    .print\:bg-gray-300 { background-color: #d1d5db !important; }
    .print\:text-gray-800 { color: #1f2937 !important; }
  }
</style>
