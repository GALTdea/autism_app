<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="bg-white rounded-lg shadow-md p-6">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Add Your Child</h1>

    <%= form_with model: @child_profile, url: child_profiles_path, local: true, class: "space-y-6" do |form| %>
      <% if @child_profile.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
          <h3 class="font-semibold mb-2">Please fix the following errors:</h3>
          <ul class="list-disc list-inside">
            <% @child_profile.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :name, "Child's Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", required: true %>
      </div>

      <div>
        <%= form.label :birth_date, "Birth Date", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.date_field :birth_date, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", required: true, max: Date.today %>
      </div>

      <div>
        <%= form.label :diagnosis_summary, "Diagnosis Summary (Optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_area :diagnosis_summary, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", placeholder: "Any relevant diagnosis information..." %>
      </div>

      <div class="flex justify-end space-x-4 pt-4">
        <%= link_to "Cancel", root_path, class: "px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50" %>
        <%= form.submit "Create Profile", class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
    <% end %>
  </div>
</div>
