<% content_for :title, "Manage Questions: #{@profile_domain.label}" %>

<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold">Manage Questions</h1>
      <p class="text-base-content/60 mt-1">
        <%= @profile_domain.label %> - <%= @profile_domain.key %>
      </p>
    </div>
    <div class="flex gap-3">
      <%= link_to "← Back to Domain", admin_profile_domain_path(@profile_domain), class: "btn btn-ghost" %>
      
      <!-- Add Question Dropdown -->
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Add Question
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
        <ul tabindex="0" class="dropdown-content menu p-2 shadow bg-base-100 rounded-box w-64 z-[1]">
          <li>
            <%= button_to "Blank Question", create_question_admin_profile_domain_path(@profile_domain),
                method: :post,
                params: { question: { response_type: 'scale', text: 'New Question' } },
                class: "btn-ghost",
                data: { turbo: false } %>
          </li>
          <li>
            <a href="#" data-action="click->question-templates#showTemplates">From Template</a>
          </li>
          <li>
            <a href="#" data-action="click->question-templates#showCopyFromDomain">Copy from Another Domain</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Integration Checks & Impact Warning -->
  <% if @impact_summary && @impact_summary[:has_active_usage] %>
    <div class="alert alert-warning">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <div>
        <div class="font-bold">⚠️ Domain is Currently in Use</div>
        <div class="text-sm mt-1">
          This domain is used in <strong><%= @impact_summary[:total_assessments] %></strong> assessment<%= 's' unless @impact_summary[:total_assessments] == 1 %>
          with <strong><%= @impact_summary[:total_sessions] %></strong> total session<%= 's' unless @impact_summary[:total_sessions] == 1 %>.
          <% if @impact_summary[:active_sessions] > 0 %>
            <strong class="text-error"><%= @impact_summary[:active_sessions] %></strong> session<%= 's' unless @impact_summary[:active_sessions] == 1 %> are currently active.
          <% end %>
          Adding, removing, or modifying questions may affect these sessions.
        </div>
        <div class="mt-2">
          <%= link_to "View Impact Details", "#{admin_profile_domain_path(@profile_domain)}#integration-checks", class: "btn btn-sm btn-warning" %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Flash Messages -->
  <% if notice %>
    <div class="alert alert-success mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span><%= notice %></span>
    </div>
  <% end %>

  <% if alert %>
    <div class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span><%= alert %></span>
    </div>
  <% end %>

  <!-- Questions List -->
  <% if @questions.any? %>
    <div class="space-y-6" 
         data-controller="sortable-questions"
         data-sortable-questions-update-url-value="<%= reorder_questions_admin_profile_domain_path(@profile_domain) %>"
         data-sortable-questions-profile-domain-id-value="<%= @profile_domain.id %>">
      <div data-sortable-questions-target="list" id="sortable-questions-list">
        <% @questions.each do |question| %>
          <%= render partial: "question_card_enhanced", locals: { question: question, profile_domain: @profile_domain } %>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body text-center py-12">
        <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-base-content/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-xl font-semibold mb-2">No Questions Yet</h3>
        <p class="text-base-content/60 mb-4">Get started by adding your first question to this domain.</p>
        <%= button_to "Add First Question", create_question_admin_profile_domain_path(@profile_domain),
            method: :post,
            params: { question: { response_type: 'scale', text: 'New Question' } },
            class: "btn btn-primary",
            data: { turbo: false } %>
      </div>
    </div>
  <% end %>

  <!-- Question Templates & Copy Modals -->
  <div data-controller="question-templates" 
       data-question-templates-profile-domain-id-value="<%= @profile_domain.id %>">
    <div data-question-templates-target="templatesModal" class="modal hidden">
      <div class="modal-box max-w-3xl max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4">
          <h3 class="font-bold text-2xl">Question Templates</h3>
          <button type="button"
                  class="btn btn-sm btn-circle btn-ghost"
                  data-action="click->question-templates#hideTemplates">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        
        <div data-question-templates-target="templatesContainer">
          <!-- Templates will be loaded here -->
        </div>
      </div>
      <div class="modal-backdrop" data-action="click->question-templates#hideTemplates"></div>
    </div>

    <div data-question-templates-target="copyModal" class="modal hidden">
      <div class="modal-box max-w-3xl max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4">
          <h3 class="font-bold text-2xl">Copy Question from Another Domain</h3>
          <button type="button"
                  class="btn btn-sm btn-circle btn-ghost"
                  data-action="click->question-templates#hideCopyFromDomain">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        
        <div data-question-templates-target="copyContainer">
          <!-- Copy form will be loaded here -->
        </div>
      </div>
      <div class="modal-backdrop" data-action="click->question-templates#hideCopyFromDomain"></div>
    </div>
  </div>

  <!-- Question Edit Modal -->
  <div data-controller="question-modal" 
       data-question-modal-target="modal"
       class="modal hidden">
    <div data-question-modal-target="backdrop" 
         class="modal-backdrop"
         data-action="click->question-modal#handleBackdropClick"></div>
    <div class="modal-box max-w-4xl max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-4">
        <h3 class="font-bold text-2xl">Edit Question</h3>
        <button type="button"
                class="btn btn-sm btn-circle btn-ghost"
                data-question-modal-target="closeButton"
                data-action="click->question-modal#close">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <div data-question-modal-target="formContainer" class="mt-4">
        <!-- Form will be loaded here via AJAX -->
      </div>
    </div>
  </div>
</div>

