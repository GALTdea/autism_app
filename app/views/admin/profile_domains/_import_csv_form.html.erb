<div class="space-y-4">
  <div class="alert alert-info">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <div>
      <div class="font-semibold">CSV Import Format</div>
      <div class="text-sm mt-1">
        Import multiple questions at once from a CSV file. Required columns: <code class="bg-base-200 px-1 rounded">code</code>, <code class="bg-base-200 px-1 rounded">text</code>, <code class="bg-base-200 px-1 rounded">response_type</code>, <code class="bg-base-200 px-1 rounded">position</code>.
        For scale and multi_choice questions, include option pairs: <code class="bg-base-200 px-1 rounded">option_1_label</code>, <code class="bg-base-200 px-1 rounded">option_1_value</code>, <code class="bg-base-200 px-1 rounded">option_2_label</code>, etc.
      </div>
      <div class="mt-2">
        <%= link_to csv_template_admin_profile_domain_questions_path(profile_domain, format: :csv),
            class: "btn btn-sm btn-info",
            target: "_blank" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download CSV Template
        <% end %>
      </div>
    </div>
  </div>

  <%= form_with url: import_csv_admin_profile_domain_questions_path(profile_domain),
      method: :post,
      multipart: true,
      local: true,
      class: "space-y-4" do |form| %>
    
    <div class="form-control w-full">
      <%= form.label :csv_file, "CSV File", class: "label" do %>
        <span class="label-text">CSV File <span class="text-error">*</span></span>
      <% end %>
      <%= form.file_field :csv_file,
          accept: ".csv,text/csv",
          class: "file-input file-input-bordered w-full",
          required: true %>
      <label class="label">
        <span class="label-text-alt">Select a CSV file to import questions from</span>
      </label>
    </div>

    <div class="alert alert-warning">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <div>
        <div class="font-semibold">Important Notes:</div>
        <ul class="list-disc list-inside text-sm mt-1 space-y-1">
          <li>Question codes must be unique across all domains</li>
          <li>Scale and multi_choice questions require at least one option</li>
          <li>Position is optional - questions will be auto-assigned if blank</li>
          <li>Duplicate codes will cause the row to be skipped</li>
          <li>All imports are processed in a transaction - errors will rollback changes</li>
        </ul>
      </div>
    </div>

    <div class="flex justify-end gap-2 pt-4 border-t">
      <button type="button" 
              class="btn btn-ghost"
              data-action="click->question-templates#hideImportCSV">
        Cancel
      </button>
      <%= form.submit "Import Questions", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>


