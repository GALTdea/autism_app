<%= form_with model: [:admin, @profile_domain], local: true, class: "space-y-6" do |form| %>
  <% if @profile_domain.errors.any? %>
    <div class="alert alert-error">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <h3 class="font-bold">Please fix the following errors:</h3>
        <ul class="list-disc list-inside mt-2">
          <% @profile_domain.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="form-control w-full">
    <%= form.label :key, class: "label" do %>
      <span class="label-text">Domain Key <span class="text-error">*</span></span>
    <% end %>
    <%= form.text_field :key, 
        class: "input input-bordered w-full #{'input-error' if @profile_domain.errors[:key].any?}", 
        placeholder: "e.g., communication, social, sensory",
        required: true,
        readonly: @profile_domain.persisted? %>
    <label class="label">
      <span class="label-text-alt">
        <% if @profile_domain.persisted? %>
          <span class="text-warning">⚠️ Domain key cannot be changed after creation (used as database identifier)</span>
        <% else %>
          A unique identifier for this domain (lowercase, no spaces). This cannot be changed after creation.
        <% end %>
      </span>
    </label>
  </div>

  <div class="form-control w-full">
    <%= form.label :label, class: "label" do %>
      <span class="label-text">Domain Label <span class="text-error">*</span></span>
    <% end %>
    <%= form.text_field :label, 
        class: "input input-bordered w-full #{'input-error' if @profile_domain.errors[:label].any?}", 
        placeholder: "e.g., Communication, Social & Play, Sensory Processing",
        required: true %>
    <label class="label">
      <span class="label-text-alt">A human-readable name for this domain (displayed to users)</span>
    </label>
  </div>

  <div class="form-control w-full">
    <%= form.label :description, class: "label" do %>
      <span class="label-text">Description</span>
    <% end %>
    <%= form.text_area :description, 
        rows: 4,
        class: "textarea textarea-bordered w-full #{'textarea-error' if @profile_domain.errors[:description].any?}", 
        placeholder: "Describe what this domain covers and what types of questions it contains..." %>
    <label class="label">
      <span class="label-text-alt">Optional description of the domain's purpose and scope</span>
    </label>
  </div>

  <div class="flex justify-end gap-3 pt-4 border-t">
    <%= link_to "Cancel", @profile_domain.persisted? ? admin_profile_domain_path(@profile_domain) : admin_profile_domains_path, class: "btn btn-ghost" %>
    <%= form.submit @profile_domain.persisted? ? "Update Domain" : "Create Domain", class: "btn btn-primary" %>
  </div>
<% end %>


