<div class="mt-4 border-t pt-4" data-controller="question-options-manager" data-question-options-manager-question-id-value="<%= question.id %>" data-question-options-manager-response-type-value="<%= question.response_type %>" data-question-options-manager-profile-domain-id-value="<%= profile_domain.id %>">
  <div class="flex justify-between items-center mb-4">
    <h4 class="font-semibold text-base">Question Options</h4>
    <button type="button" 
            class="btn btn-sm btn-primary"
            data-question-options-manager-target="addButton"
            data-action="click->question-options-manager#showAddForm">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Add Option
    </button>
  </div>

  <!-- Info Alert -->
  <div class="alert alert-info mb-4" data-question-options-manager-target="infoAlert">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <div>
      <p class="font-semibold" data-question-options-manager-target="infoTitle">
        <%= question.scale? ? "Scale Question" : "Multi-Choice Question" %>
      </p>
      <p class="text-sm mt-1" data-question-options-manager-target="infoText">
        <% if question.scale? %>
          Add options in order from highest to lowest value (e.g., 4=Always, 3=Often, 2=Sometimes, 1=Rarely, 0=Never).
          Values should typically range from 0-4 or 0-5.
        <% else %>
          Add all available choices. Values represent the option's significance (can be any numeric value).
        <% end %>
      </p>
    </div>
  </div>

  <!-- Add Option Form (Initially Hidden) -->
  <div class="hidden mb-4" data-question-options-manager-target="addForm">
    <div class="card bg-base-200">
      <div class="card-body">
        <%= form_with url: admin_profile_domain_question_question_options_path(profile_domain, question),
            method: :post,
            local: false,
            data: { 
              turbo_frame: "question-options-#{question.id}",
              action: "turbo:submit-end->question-options-manager#handleSubmit"
            },
            class: "space-y-4" do |form| %>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="form-control flex-1">
              <%= form.label :label, class: "label" do %>
                <span class="label-text">Label <span class="text-error">*</span></span>
              <% end %>
              <%= form.text_field :label,
                  class: "input input-bordered w-full",
                  placeholder: "e.g., Always, Often, Sometimes",
                  required: true,
                  data: { question_options_manager_target: "labelInput" } %>
            </div>

            <div class="form-control">
              <%= form.label :value, class: "label" do %>
                <span class="label-text">Value <span class="text-error">*</span></span>
              <% end %>
              <%= form.number_field :value,
                  class: "input input-bordered w-full",
                  placeholder: question.scale? ? "0-4 or 0-5" : "Any number",
                  min: 0,
                  step: 1,
                  required: true,
                  data: { 
                    question_options_manager_target: "valueInput",
                    question_options_manager_response_type_param: question.response_type
                  } %>
              <label class="label">
                <span class="label-text-alt">
                  <% if question.scale? %>
                    Numeric value (0-4 or 0-5 typical)
                  <% else %>
                    Numeric significance value
                  <% end %>
                </span>
              </label>
            </div>

            <div class="form-control flex items-end">
              <div class="flex gap-2">
                <%= form.submit "Add Option", class: "btn btn-primary btn-sm" %>
                <button type="button" 
                        class="btn btn-ghost btn-sm"
                        data-action="click->question-options-manager#hideAddForm">
                  Cancel
                </button>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Options List -->
  <% if question.question_options.any? %>
    <div class="space-y-2" 
         data-question-options-manager-target="optionsList"
         data-sortable-options-target="list">
      <% question.question_options.ordered.each_with_index do |option, index| %>
        <div class="flex items-center gap-3 p-3 bg-base-200 rounded-lg border border-base-300 hover:border-primary/50 transition-colors"
             draggable="true"
             data-option-id="<%= option.id %>"
             data-question-options-manager-target="optionRow"
             data-sortable-options-target="item">
          
          <!-- Drag Handle -->
          <div class="cursor-move text-base-content/40 hover:text-base-content/80">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16" />
            </svg>
          </div>

          <!-- Position Badge -->
          <span class="badge badge-lg badge-neutral min-w-[2.5rem] justify-center" data-sortable-options-target="positionBadge">
            <%= index + 1 %>
          </span>

          <!-- Option Fields (Inline Editing) -->
          <div class="flex-1 grid grid-cols-1 md:grid-cols-2 gap-3">
            <!-- Label -->
            <div class="form-control">
              <input type="text"
                     value="<%= option.label %>"
                     placeholder="Option label"
                     class="input input-bordered input-sm"
                     data-question-options-manager-target="labelField"
                     data-option-id="<%= option.id %>"
                     data-action="blur->question-options-manager#updateOption">
            </div>

            <!-- Value -->
            <div class="form-control">
              <input type="number"
                     value="<%= option.value %>"
                     placeholder="Value"
                     class="input input-bordered input-sm"
                     min="0"
                     step="1"
                     data-question-options-manager-target="valueField"
                     data-option-id="<%= option.id %>"
                     data-action="blur->question-options-manager#updateOption">
              <% if question.scale? %>
                <label class="label">
                  <span class="label-text-alt text-xs">
                    <% if option.value > 4 %>
                      <span class="text-warning">⚠️ Typically 0-4 or 0-5 for scales</span>
                    <% end %>
                  </span>
                </label>
              <% end %>
            </div>
          </div>

          <!-- Delete Button -->
          <button type="button"
                  class="btn btn-sm btn-error btn-ghost"
                  data-action="click->question-options-manager#deleteOption"
                  data-option-id="<%= option.id %>">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      <% end %>
    </div>

    <!-- Reorder Hint -->
    <div class="text-xs text-base-content/60 mt-2 flex items-center gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      Drag and drop to reorder options. Changes are saved automatically.
    </div>
  <% else %>
    <div class="alert alert-warning" data-question-options-manager-target="emptyState">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span>No options added yet. Click "Add Option" to add response choices.</span>
    </div>
  <% end %>
</div>

