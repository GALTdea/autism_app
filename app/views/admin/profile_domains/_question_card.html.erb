<div class="card bg-base-100 shadow-xl" id="question-<%= question.id %>">
  <div class="card-body">
    <!-- Question Header -->
    <div class="flex justify-between items-start mb-4">
      <div class="flex-1">
        <div class="flex items-center gap-3 mb-2">
          <span class="badge badge-lg badge-outline">#<%= question.position + 1 %></span>
          <span class="badge badge-ghost font-mono text-xs"><%= question.code %></span>
          <span class="badge <%= question.scale? ? 'badge-primary' : (question.multi_choice? ? 'badge-secondary' : 'badge-accent') %>">
            <%= question.response_type.humanize %>
          </span>
        </div>
        <h3 class="text-lg font-semibold"><%= question.text %></h3>
      </div>
      <div class="flex gap-2">
        <%= link_to "Edit", edit_admin_profile_domain_path(profile_domain), class: "btn btn-sm btn-ghost" %>
        <%= button_to "Delete", destroy_question_admin_profile_domain_path(profile_domain, question_id: question.id),
            method: :delete,
            data: {
              turbo_confirm: "Are you sure you want to delete this question? This cannot be undone.",
              turbo: false
            },
            class: "btn btn-sm btn-error btn-ghost" %>
      </div>
    </div>

    <!-- Question Options Management (only for scale and multi_choice) -->
    <% if question.scale? || question.multi_choice? %>
      <%= render partial: "question_options_management", locals: { question: question, profile_domain: profile_domain } %>
    <% elsif question.text? %>
      <div class="alert alert-info">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>Text questions don't require options. Users will provide free-form text responses.</span>
      </div>
    <% end %>
  </div>
</div>

