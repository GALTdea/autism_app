<% content_for :title, "Edit Profile Domain: #{@profile_domain.label}" %>

<div class="space-y-6">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold">Edit Profile Domain</h1>
      <p class="text-base-content/70 mt-2">
        Update the basic information for <strong><%= @profile_domain.label %></strong>.
      </p>
    </div>
    <div class="flex gap-2">
      <%= link_to "← Back to Domain", admin_profile_domain_path(@profile_domain), class: "btn btn-ghost" %>
      <%= link_to "View All", admin_profile_domains_path, class: "btn btn-ghost" %>
    </div>
  </div>

  <!-- Warning if domain is in use -->
  <% if @profile_domain.assessments.any? || @profile_domain.child_profiles.any? %>
    <div class="alert alert-warning">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span>This domain is being used in <%= pluralize(@profile_domain.assessments.count, 'assessment') %> and <%= pluralize(@profile_domain.child_profiles.count, 'child profile') %>. Changes may affect existing data.</span>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Basic Info Form -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Basic Information</h2>
        <%= render "form" %>
      </div>
    </div>

    <!-- Domain Details & Quick Actions -->
    <div class="space-y-6">
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <h2 class="card-title">Domain Details</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <div class="text-sm text-base-content/60">Questions</div>
              <div class="font-semibold text-lg">
                <%= @profile_domain.questions.count %>
                <% if @profile_domain.questions.any? %>
                  <%= link_to "Manage", manage_questions_admin_profile_domain_path(@profile_domain), class: "btn btn-xs btn-ghost ml-2" %>
                <% end %>
              </div>
            </div>
            <div>
              <div class="text-sm text-base-content/60">Assessments</div>
              <div class="font-semibold text-lg"><%= @profile_domain.assessments.count %></div>
            </div>
            <div>
              <div class="text-sm text-base-content/60">Child Profiles</div>
              <div class="font-semibold text-lg"><%= @profile_domain.child_profiles.count %></div>
            </div>
            <div>
              <div class="text-sm text-base-content/60">Created</div>
              <div class="font-semibold text-lg"><%= time_ago_in_words(@profile_domain.created_at) %> ago</div>
            </div>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title">Domain Builder Actions</h2>
          <p class="text-sm text-base-content/60 mb-4">
            Manage questions and configure this domain.
          </p>
          <div class="flex flex-wrap gap-2">
            <% if @profile_domain.questions.any? %>
              <%= link_to "Manage Questions", manage_questions_admin_profile_domain_path(@profile_domain),
                  class: "btn btn-outline btn-sm" %>
              <%= link_to "Preview Domain", preview_admin_profile_domain_path(@profile_domain),
                  class: "btn btn-outline btn-sm" %>
            <% else %>
              <%= link_to "Add Questions", manage_questions_admin_profile_domain_path(@profile_domain),
                  class: "btn btn-outline btn-sm btn-primary" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Current Questions List -->
  <% if @profile_domain.questions.any? %>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Current Questions (<%= @profile_domain.questions.count %>)</h2>
        <div class="overflow-x-auto">
          <table class="table table-zebra w-full">
            <thead>
              <tr>
                <th>Order</th>
                <th>Code</th>
                <th>Question</th>
                <th>Type</th>
                <th>Options</th>
              </tr>
            </thead>
            <tbody>
              <% @questions.each do |question| %>
                <tr>
                  <td><span class="badge badge-outline"><%= question.position + 1 %></span></td>
                  <td><span class="badge badge-ghost font-mono text-xs"><%= question.code %></span></td>
                  <td><%= question.text.truncate(60) %></td>
                  <td>
                    <span class="badge <%= question.scale? ? 'badge-primary' : (question.multi_choice? ? 'badge-secondary' : 'badge-accent') %>">
                      <%= question.response_type.humanize %>
                    </span>
                  </td>
                  <td><span class="badge badge-info"><%= question.question_options.count %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="card-actions justify-end mt-4">
          <%= link_to "Manage Questions", manage_questions_admin_profile_domain_path(@profile_domain), class: "btn btn-sm btn-ghost" %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Current Questions</h2>
        <div class="alert alert-info">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>No questions have been added to this domain yet.</span>
          <%= link_to "Add Questions", manage_questions_admin_profile_domain_path(@profile_domain), class: "btn btn-sm btn-primary" %>
        </div>
      </div>
    </div>
  <% end %>
</div>



