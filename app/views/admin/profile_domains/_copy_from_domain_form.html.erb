<div class="space-y-4">
  <p class="text-sm text-base-content/60">
    Copy a question from another domain. The question and its options will be copied with a new code.
  </p>

  <% other_domains = other_domains || @other_domains %>
  <% if other_domains.any? %>
    <div class="space-y-4">
      <% other_domains.each do |domain| %>
        <div class="card bg-base-200 shadow">
          <div class="card-body p-4">
            <h3 class="card-title text-base">
              <%= domain.label %>
              <span class="badge badge-sm badge-ghost font-mono text-xs ml-2"><%= domain.key %></span>
            </h3>
            <p class="text-xs text-base-content/70 mb-3">
              <%= pluralize(domain.questions.count, 'question') %> available
            </p>

            <% domain.questions.ordered.each do |question| %>
              <div class="flex items-center justify-between p-2 bg-base-100 rounded mb-2">
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="badge badge-xs badge-ghost font-mono"><%= question.code %></span>
                    <span class="badge badge-xs <%= question.scale? ? 'badge-primary' : (question.multi_choice? ? 'badge-secondary' : 'badge-accent') %>">
                      <%= question.response_type.humanize %>
                    </span>
                    <% if question.question_options.any? %>
                      <span class="badge badge-xs badge-info">
                        <%= question.question_options.count %> options
                      </span>
                    <% end %>
                  </div>
                  <div class="text-sm font-medium"><%= question.text %></div>
                </div>
                <%= form_with url: copy_from_domain_admin_profile_domain_questions_path(profile_domain),
                    method: :post,
                    local: false,
                    class: "ml-2",
                    data: { 
                      turbo: true,
                      turbo_frame: "_top"
                    } do |form| %>
                  <%= form.hidden_field :source_question_id, value: question.id %>
                  <%= form.submit "Copy", class: "btn btn-xs btn-primary" %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <span>No other domains with questions found. Create questions in other domains first to copy them.</span>
    </div>
  <% end %>
</div>

