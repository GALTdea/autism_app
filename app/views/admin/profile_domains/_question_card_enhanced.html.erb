<div class="card bg-base-100 shadow-xl border border-base-300 hover:shadow-2xl transition-shadow"
     id="question-<%= question.id %>"
     data-controller="question-card"
     data-question-card-question-id-value="<%= question.id %>"
     data-question-card-profile-domain-id-value="<%= profile_domain.id %>"
     data-question-card-is-collapsed-value="true"
     data-sortable-questions-target="item"
     data-question-id="<%= question.id %>"
     draggable="true">
  
  <div class="card-body">
    <!-- Question Header (Always Visible) -->
    <div class="flex justify-between items-start gap-4">
      <!-- Left Side: Question Info -->
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-3 mb-3 flex-wrap">
          <!-- Position Badge with Drag Handle -->
          <div class="flex items-center gap-2">
            <div class="cursor-move text-base-content/40 hover:text-base-content/80" title="Drag to reorder">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16" />
              </svg>
            </div>
            <span class="badge badge-lg badge-outline font-semibold" data-sortable-questions-target="positionBadge">
              #<%= question.position + 1 %>
            </span>
          </div>

          <!-- Question Code -->
          <span class="badge badge-ghost font-mono text-xs" data-question-card-target="questionCode">
            <%= question.code %>
          </span>

          <!-- Question Type Badge with Icon -->
          <span class="badge <%= question_type_badge_class(question) %> badge-lg flex items-center gap-1.5" data-question-card-target="questionType">
            <%= question_type_icon(question) %>
            <span><%= question.response_type.humanize %></span>
          </span>

          <!-- Options Count Badge (if applicable) -->
          <% if question.scale? || question.multi_choice? %>
            <% option_count = question.question_options.count %>
            <span class="badge badge-info">
              <%= option_count %> option<%= 's' unless option_count == 1 %>
            </span>
          <% end %>
        </div>

        <!-- Question Text (View Mode) -->
        <div data-question-card-target="viewMode">
          <h3 class="text-lg font-semibold text-base-content mb-2" data-question-card-target="questionText">
            <%= question.text %>
          </h3>
        </div>

        <!-- Inline Edit Form (Hidden by default) -->
        <div data-question-card-target="inlineEditForm" class="hidden">
          <%= form_with url: update_question_admin_profile_domain_path(profile_domain, question_id: question.id),
              method: :patch,
              local: false,
              data: { 
                controller: "question-form",
                question_form_response_type_value: question.response_type,
                action: "turbo:submit-end->question-card#saveInlineEdit",
                turbo: true,
                turbo_frame: "_top"
              },
              class: "space-y-3" do |form| %>
            
            <%= form.hidden_field :profile_domain_id, value: profile_domain.id %>
            
            <div class="form-control">
              <%= form.text_area :text, 
                  rows: 2,
                  class: "textarea textarea-bordered w-full textarea-sm",
                  placeholder: "Enter question text...",
                  required: true,
                  minlength: 10,
                  maxlength: 500,
                  value: question.text,
                  data: { 
                    question_form_target: "textInput",
                    action: "input->question-form#validateText blur->question-form#validateText"
                  } %>
              <label class="label">
                <span class="label-text-alt">
                  <span data-question-form-target="textCount" class="text-base-content/60">
                    <%= question.text.length %> / 500 characters
                  </span>
                </span>
              </label>
              <div data-question-form-target="textError" class="hidden text-error text-sm mt-1"></div>
            </div>

            <div class="flex gap-2">
              <button type="submit" 
                      class="btn btn-sm btn-primary"
                      data-question-card-target="saveButton">
                Save
              </button>
              <button type="button" 
                      class="btn btn-sm btn-ghost"
                      data-question-card-target="cancelButton"
                      data-action="click->question-card#cancelInlineEdit">
                Cancel
              </button>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Right Side: Actions -->
      <div class="flex gap-2 flex-shrink-0">
        <!-- Collapse/Expand Button -->
        <% if question.scale? || question.multi_choice? %>
          <button type="button"
                  class="btn btn-sm btn-ghost btn-circle"
                  data-question-card-target="collapseButton"
                  data-action="click->question-card#toggleCollapse"
                  title="Toggle options">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        <% end %>

        <!-- Quick Edit (Inline) -->
        <button type="button"
                class="btn btn-sm btn-ghost"
                data-question-card-target="editButton"
                data-action="click->question-card#enableInlineEdit"
                title="Quick edit">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        </button>

        <!-- Full Edit (Modal) -->
        <button type="button"
                class="btn btn-sm btn-primary"
                data-action="click->question-card#openEditModal"
                title="Full edit">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
          Edit
        </button>

        <!-- Delete Button -->
        <%= button_to destroy_question_admin_profile_domain_path(profile_domain, question_id: question.id),
            method: :delete,
            data: {
              turbo_confirm: "Are you sure you want to delete this question? This cannot be undone.",
              turbo: false
            },
            class: "btn btn-sm btn-error btn-ghost",
            title: "Delete question" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        <% end %>
      </div>
    </div>

    <!-- Collapsible Content: Question Options -->
    <div data-question-card-target="collapseContent" class="hidden mt-4 pt-4 border-t border-base-300">
      <% if question.scale? || question.multi_choice? %>
        <%= render partial: "question_options_management", locals: { question: question, profile_domain: profile_domain } %>
      <% elsif question.text? %>
        <div class="alert alert-info">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Text questions don't require options. Users will provide free-form text responses.</span>
        </div>
      <% end %>
    </div>
  </div>
</div>

