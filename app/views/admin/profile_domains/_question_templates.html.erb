<% templates = QuestionTemplateService.all_templates %>

<div class="space-y-4">
  <p class="text-sm text-base-content/60">
    Select a template to quickly create a question with pre-configured options.
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <% templates.each do |key, template| %>
      <div class="card bg-base-200 shadow">
        <div class="card-body p-4">
          <h3 class="card-title text-lg"><%= template[:name] %></h3>
          <p class="text-sm text-base-content/70 mb-3"><%= template[:description] %></p>
          
          <% if template[:options].any? %>
            <div class="mb-3">
              <div class="text-xs font-semibold text-base-content/60 mb-1">Options:</div>
              <div class="flex flex-wrap gap-1">
                <% template[:options].each do |option| %>
                  <span class="badge badge-sm badge-neutral">
                    <%= option[:label] %> (<%= option[:value] %>)
                  </span>
                <% end %>
              </div>
            </div>
          <% else %>
            <div class="badge badge-sm badge-accent mb-3">Text Response</div>
          <% end %>

          <%= form_with url: create_from_template_admin_profile_domain_questions_path(profile_domain),
              method: :post,
              local: false,
              class: "mt-3",
              data: { 
                turbo: true,
                turbo_frame: "_top",
                action: "turbo:submit-end->question-templates#handleTemplateSubmit"
              } do |form| %>
            <%= form.hidden_field :template_key, value: key %>
            
            <div class="form-control mb-3">
              <%= form.label :question_text, "Question Text (Optional)", class: "label label-text text-xs" %>
              <%= form.text_area :question_text, 
                  rows: 2,
                  class: "textarea textarea-bordered textarea-sm",
                  placeholder: "Enter question text, or leave blank to use default..." %>
            </div>

            <%= form.submit "Create from Template", class: "btn btn-sm btn-primary w-full" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

