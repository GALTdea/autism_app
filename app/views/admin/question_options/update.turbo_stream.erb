<%= turbo_stream.replace "question-#{@question.id}" do %>
  <%= render partial: "admin/profile_domains/question_card", locals: { question: @question, profile_domain: @profile_domain } %>
<% end %>

<%= turbo_stream.prepend "flash-container" do %>
  <div class="alert alert-success fixed top-4 right-4 z-50 max-w-md shadow-lg" data-controller="flash-dismiss">
    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span>Option updated successfully.</span>
    <button onclick="this.parentElement.remove()" class="btn btn-sm btn-circle btn-ghost">✕</button>
  </div>
<% end %>

