<%# Refresh the entire questions list %>
<%= turbo_stream.replace "questions-list" do %>
  <div id="questions-list">
    <% if @questions.any? %>
      <div class="space-y-6">
        <% @questions.each do |question| %>
          <div class="card bg-base-100 shadow-lg">
            <div class="card-body">
              <div class="flex justify-between items-start">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <span class="badge badge-outline badge-lg"><%= question.position + 1 %></span>
                    <span class="badge badge-ghost font-mono text-xs"><%= question.code %></span>
                    <span class="badge <%= question.scale? ? 'badge-primary' : (question.multi_choice? ? 'badge-secondary' : 'badge-accent') %>">
                      <%= question.response_type.humanize %>
                    </span>
                  </div>
                  <h3 class="text-xl font-semibold mb-2"><%= question.text %></h3>
                  <% if question.question_options.any? %>
                    <div class="mt-3">
                      <div class="text-sm font-semibold mb-2">Options:</div>
                      <div class="flex flex-wrap gap-2">
                        <% question.question_options.ordered.each do |option| %>
                          <span class="badge badge-info">
                            <%= option.label %> (<%= option.value %>)
                          </span>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
                <div class="flex gap-2">
                  <%= link_to "Edit", "#", 
                      class: "btn btn-sm btn-ghost",
                      data: { 
                        action: "click->question-form#showEditForm",
                        question_id: question.id
                      } %>
                  <%= button_to "Delete", 
                      destroy_question_admin_assessment_domain_path(@assessment_domain, question_id: question.id),
                      method: :delete,
                      class: "btn btn-sm btn-error btn-ghost",
                      data: { 
                        turbo_confirm: "Are you sure you want to delete this question?"
                      } %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body text-center py-12">
          <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-base-content/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h3 class="text-xl font-semibold mb-2">No Questions Yet</h3>
          <p class="text-base-content/60 mb-4">Get started by adding your first question to this domain.</p>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<%# Show success message %>
<%= turbo_stream.update "flash" do %>
  <div class="alert alert-success">
    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span>Question created successfully.</span>
  </div>
<% end %>

<%# Close the modal %>
<%= turbo_stream.append "question-modal" do %>
  <script>
    // Close the modal
    const modal = document.getElementById('question-modal');
    if (modal) {
      modal.classList.remove('modal-open');
    }
  </script>
<% end %>

