<% content_for :title, "Manage Questions: #{@assessment_domain.display_name}" %>

<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold">Manage Questions</h1>
      <p class="text-base-content/60 mt-1">
        <%= @assessment_domain.display_name %>
        <% if @assessment_domain.version.present? %>
          - Version <%= @assessment_domain.version %>
        <% end %>
      </p>
    </div>
    <div class="flex gap-3">
      <%= link_to "← Back to Domain", admin_assessment_domain_path(@assessment_domain), class: "btn btn-ghost" %>
      
      <!-- Add Question Button -->
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Add Question
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
        <ul tabindex="0" class="dropdown-content menu p-2 shadow bg-base-100 rounded-box w-64 z-[1]">
          <li>
            <%= link_to "Blank Question", "#",
                class: "btn-ghost",
                data: { 
                  action: "click->question-form#showBlankForm",
                  question_form_domain_id_param: @assessment_domain.id
                } %>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Flash Messages -->
  <% if notice %>
    <div class="alert alert-success mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span><%= notice %></span>
    </div>
  <% end %>

  <% if alert %>
    <div class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span><%= alert %></span>
    </div>
  <% end %>

  <!-- Questions List -->
  <% if @questions.any? %>
    <div class="space-y-6">
      <% @questions.each do |question| %>
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <span class="badge badge-outline badge-lg"><%= question.position + 1 %></span>
                  <span class="badge badge-ghost font-mono text-xs"><%= question.code %></span>
                  <span class="badge <%= question.scale? ? 'badge-primary' : (question.multi_choice? ? 'badge-secondary' : 'badge-accent') %>">
                    <%= question.response_type.humanize %>
                  </span>
                </div>
                <h3 class="text-xl font-semibold mb-2"><%= question.text %></h3>
                <% if question.question_options.any? %>
                  <div class="mt-3">
                    <div class="text-sm font-semibold mb-2">Options:</div>
                    <div class="flex flex-wrap gap-2">
                      <% question.question_options.ordered.each do |option| %>
                        <span class="badge badge-info">
                          <%= option.label %> (<%= option.value %>)
                        </span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
              <div class="flex gap-2">
                <%= link_to "Edit", "#",
                    class: "btn btn-sm btn-ghost",
                    data: { 
                      action: "click->question-form#showEditForm",
                      question_form_question_id_param: question.id
                    } %>
                <%= link_to "Delete", destroy_question_admin_assessment_domain_path(@assessment_domain, question_id: question.id),
                    method: :delete,
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "Are you sure you want to delete this question?"
                    },
                    class: "btn btn-sm btn-error btn-ghost" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-warning">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <div>
        <h3 class="font-bold">No questions yet</h3>
        <div class="text-xs">Add your first question to get started.</div>
      </div>
    </div>
  <% end %>

  <!-- Question Form Modal (simplified for now) -->
  <div id="question-form-modal" class="hidden">
    <!-- Form would be rendered here via Turbo or Stimulus -->
  </div>

  <!-- Navigation -->
  <div class="flex justify-between items-center mt-8 pt-4 border-t border-base-300">
    <%= link_to "← Back to Domain", admin_assessment_domain_path(@assessment_domain), class: "btn btn-ghost" %>
    <div class="flex gap-2">
      <% if @questions.any? %>
        <%= link_to "Preview Domain", preview_admin_assessment_domain_path(@assessment_domain), class: "btn btn-info" %>
      <% end %>
    </div>
  </div>
</div>

