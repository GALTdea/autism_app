          <li><%= link_to "Analytics", admin_analytics_path %></li>
        </ul>
      </li>
    </ul>
  </div>
  
  <div class="navbar-end">
    <%= link_to "Back to App", root_path, class: "btn btn-ghost" %>
    <div class="dropdown dropdown-end">
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
        <div class="bg-neutral text-neutral-content rounded-full w-10">
          <span><%= current_user.email[0].upcase %></span>
        </div>
      </div>
      <ul tabindex="0" class="mt-3 z-[1] p-2 shadow menu menu-sm dropdown-content bg-base-100 rounded-box w-52">
        <li class="menu-title"><%= current_user.email %></li>
        <% if current_user.super_admin? %>
          <li class="disabled"><span class="text-xs text-error uppercase">Super Admin</span></li>
        <% else %>
          <li class="disabled"><span class="text-xs text-warning uppercase">Admin</span></li>
        <% end %>
        <li><%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-error" %></li>
      </ul>
    </div>
  </div>
</div>
