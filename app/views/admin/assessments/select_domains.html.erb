<% content_for :title, "Select Domains: #{@assessment.name}" %>

<div class="space-y-6" data-controller="assessment-builder" data-assessment-builder-current-step-value="2" data-assessment-builder-total-steps-value="4" data-assessment-builder-assessment-id-value="<%= @assessment.id %>">
  <!-- Header -->
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold">Select Domains</h1>
      <p class="text-base-content/70 mt-2">
        Choose which assessment domains to include in <strong><%= @assessment.name %></strong> (v<%= @assessment.version %>).
      </p>
    </div>
    <%= link_to "← Back to Assessment", admin_assessment_path(@assessment), class: "btn btn-ghost" %>
  </div>

  <!-- Progress Indicator -->
  <div class="card bg-base-200 shadow">
    <div class="card-body py-4">
      <div class="flex items-center justify-between mb-2">
        <div class="text-sm font-semibold">
          Step <span data-assessment-builder-target="currentStep"><%= 2 %></span> of <span data-assessment-builder-target="totalSteps">4</span>
        </div>
        <div class="text-xs text-base-content/60">Select Domains</div>
      </div>
      <div class="w-full bg-base-300 rounded-full h-2">
        <div class="bg-primary h-2 rounded-full transition-all duration-300" data-assessment-builder-target="progressBar" style="width: 50%"></div>
      </div>
      <div class="steps steps-vertical lg:steps-horizontal mt-4">
        <div class="step step-primary">
          <div class="step-content">
            <div class="font-semibold">Step 1: Basic Info</div>
            <div class="text-xs text-base-content/60">✓ Completed</div>
          </div>
        </div>
        <div class="step step-primary">
          <div class="step-content">
            <div class="font-semibold">Step 2: Select Domains</div>
            <div class="text-xs text-base-content/60">In Progress</div>
          </div>
        </div>
        <div class="step">
          <div class="step-content">
            <div class="font-semibold">Step 3: Order Domains</div>
            <div class="text-xs text-base-content/60">Next</div>
          </div>
        </div>
        <div class="step">
          <div class="step-content">
            <div class="font-semibold">Step 4: Preview</div>
            <div class="text-xs text-base-content/60">Final</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%= form_with url: update_domains_admin_assessment_path(@assessment), method: :patch, local: true, class: "space-y-6", id: "select-domains-form" do |form| %>
    <!-- Selected Domains -->
    <% if @assessment_domains.any? %>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title">Currently Selected (<%= @assessment_domains.count %>)</h2>
          <p class="text-sm text-base-content/60 mb-4">These domains are already added to this assessment</p>
          <div class="space-y-2">
            <% @assessment_domains.each do |assessment_domain| %>
              <div class="flex items-center justify-between p-3 bg-base-200 rounded-box">
                <div class="flex items-center gap-3">
                  <!-- Display only, not editable in this flow -->
                  <div class="w-5 h-5 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <div>
                    <div class="font-semibold"><%= assessment_domain.display_name %></div>
                    <div class="text-xs text-base-content/60">
                      <%= assessment_domain.description.presence || assessment_domain.domain_key %>
                    </div>
                    <% if assessment_domain.version.present? %>
                      <div class="text-xs text-base-content/50">v<%= assessment_domain.version %></div>
                    <% end %>
                    <div class="text-xs text-base-content/50 mt-1">
                      <%= assessment_domain.questions.count %> questions
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Available Domains -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <div class="flex justify-between items-center mb-4">
          <h2 class="card-title">Available Domains</h2>
          <div class="flex gap-2">
            <button type="button" onclick="document.querySelectorAll('#select-domains-form input[type=checkbox]').forEach(c => c.checked = true)" class="btn btn-xs btn-ghost">
              Select All
            </button>
            <button type="button" onclick="document.querySelectorAll('#select-domains-form input[type=checkbox]').forEach(c => c.checked = false)" class="btn btn-xs btn-ghost">
              Deselect All
            </button>
          </div>
        </div>

        <%= render partial: "available_domains_list" %>
      </div>
    </div>

    <!-- Form Actions -->
    <div class="flex justify-between items-center pt-4 border-t">
      <%= link_to "Back to Assessment", admin_assessment_path(@assessment), class: "btn btn-ghost" %>
      <div class="flex gap-2">
        <%= form.submit "Add Selected Domains & Continue", 
            class: "btn btn-primary",
            id: "submit-domains",
            onclick: "const checked = document.querySelectorAll('#select-domains-form input[type=checkbox]:checked:not(:disabled)').length; if (checked === 0) { alert('Please select at least one available domain to add'); return false; } return true;" %>
      </div>
    </div>
  <% end %>
</div>

