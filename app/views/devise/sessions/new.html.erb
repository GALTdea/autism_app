<div class="flex justify-center items-center min-h-[calc(100vh-8rem)] bg-base-200">
  <div class="card w-96 bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title justify-center mb-4">Welcome Back</h2>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="form-control w-full">
          <label class="label"><span class="label-text">Email</span></label>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
        </div>
        <div class="form-control w-full mt-2">
          <label class="label"><span class="label-text">Password</span></label>
          <%= f.password_field :password, autocomplete: "current-password", class: "input input-bordered w-full" %>
          <label class="label"><a href="<%= new_password_path(resource_name) %>" class="label-text-alt link link-hover">Forgot password?</a></label>
        </div>
        <% if devise_mapping.rememberable? %>
          <div class="form-control">
            <label class="label cursor-pointer justify-start gap-2">
              <%= f.check_box :remember_me, class: "checkbox checkbox-sm" %>
              <span class="label-text">Remember me</span>
            </label>
          </div>
        <% end %>
        <div class="card-actions justify-end mt-4">
          <%= f.submit "Log in", class: "btn btn-primary w-full" %>
        </div>
      <% end %>
      <div class="divider">OR</div>
      <div class="text-center">
        <a href="<%= new_registration_path(resource_name) %>" class="link link-primary">Create an account</a>
      </div>
    </div>
  </div>
</div>
