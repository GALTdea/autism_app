<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Today's Recommended Activities</h1>
    <p class="text-gray-600 mt-2">Personalized activities for <%= @child_profile.name %></p>
    <% if @daily_recommendation %>
      <p class="text-sm text-gray-500 mt-1">
        Generated on <%= @daily_recommendation.computed_at.strftime("%B %d at %I:%M %p") %>
      </p>
    <% end %>
  </div>

  <% if @recommendations.empty? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
      <h2 class="text-xl font-semibold text-yellow-900 mb-2">No Recommendations Yet</h2>
      <p class="text-yellow-800">
        We need more information about your child to generate personalized recommendations.
        <% unless @child_profile.onboarding_sessions.completed.any? %>
          <%= link_to "Complete onboarding", start_onboarding_child_profile_path(@child_profile), 
              class: "underline font-medium" %> to get started.
        <% end %>
      </p>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <% @recommendations.each_with_index do |activity, index| %>
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
          <div class="flex items-start justify-between mb-4">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <% case index %>
                <% when 0 %>
                  <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded">
                    Anchor Favorite
                  </span>
                <% when 1 %>
                  <span class="px-2 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded">
                    Goal-Focused
                  </span>
                <% when 2 %>
                  <span class="px-2 py-1 text-xs font-medium bg-purple-100 text-purple-800 rounded">
                    Novelty Option
                  </span>
                <% end %>
              </div>
              <h2 class="text-xl font-semibold text-gray-900 mb-2"><%= activity.title %></h2>
            </div>
            <span class="px-2 py-1 text-xs font-medium bg-gray-100 text-gray-800 rounded">
              <%= activity.duration_minutes %> min
            </span>
          </div>

          <div class="mb-4">
            <span class="inline-block px-3 py-1 text-sm font-medium bg-blue-100 text-blue-800 rounded">
              <%= activity.primary_target.label %>
            </span>
          </div>

          <p class="text-gray-600 mb-4 line-clamp-3">
            <%= truncate(activity.parent_script, length: 120) %>
          </p>

          <%= link_to "View Details", activity_template_path(activity), 
              class: "inline-block w-full text-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors" %>
        </div>
      <% end %>
    </div>

    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
      <p class="text-sm text-blue-800">
        <strong>Tip:</strong> These recommendations are personalized based on your child's profile and goals.
        New recommendations are generated daily. You can also 
        <%= link_to "browse all activities", activity_templates_path, class: "underline font-medium" %>.
      </p>
    </div>
  <% end %>
</div>
